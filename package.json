{
  "name": "stash-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "dev:ui": "vp dev",
    "start": "bun server/index.ts",
    "build": "vue-tsc -p tsconfig.json --noEmit && vp build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "vp lint src",
    "prepare": "vp config"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "hono": "^4.13.11",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "pino": "^10.3.1",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "packageManager": "bun@1.4.2"
}
